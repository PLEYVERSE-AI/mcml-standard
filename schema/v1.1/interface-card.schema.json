{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcml-standard.org/schemas/v1.1/interface-card.schema.json",
  "title": "MCML Interface Card",
  "description": "Governance metadata for an API endpoint or service that exposes a model or agent (MCML v1.1 draft).",
  "type": "object",
  "required": ["interface_card"],
  "properties": {
    "interface_card": {
      "type": "object",
      "required": ["service_name", "authentication_method", "logging_level", "service_owner"],
      "properties": {
        "service_name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "model_ref": {"type": "string", "pattern": "^model://"},
        "api_specification_url": {"type": "string"},
        "supported_protocols": {"type": "array", "items": {"type": "string"}},
        "base_url": {"type": "string"},
        "authentication_method": {"type": "string", "minLength": 1},
        "access_control_policy": {
          "type": "object",
          "properties": {
            "authorized_roles": {"type": "array", "items": {"type": "string"}},
            "ip_whitelist": {"type": "array", "items": {"type": "string"}}
          }
        },
        "rate_limits": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "data_classification": {"enum": ["public", "internal", "confidential", "restricted"]},
        "pii_handling_policy": {"type": "string"},
        "logging_level": {"enum": ["none", "basic", "standard", "detailed"]},
        "log_retention_days": {"type": "integer", "minimum": 0},
        "audit_requirements": {"type": "array", "items": {"type": "string"}},
        "compliance_frameworks": {"type": "array", "items": {"type": "string"}},
        "data_residency_requirements": {
          "type": "object",
          "properties": {
            "allowed_regions": {"type": "array", "items": {"type": "string"}},
            "prohibited_regions": {"type": "array", "items": {"type": "string"}}
          }
        },
        "service_owner": {"type": "string", "minLength": 1},
        "contact_email": {"type": "string"}
      }
    }
  }
}
